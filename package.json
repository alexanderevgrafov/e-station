{
  "name": "e-station",
  "version": "1.0.0",
  "description": "E-paper clock and layout editor for a WeAct 4.2\" panel on a Pi Zero 2W",
  "main": "server.ts",
  "type": "module",
  "scripts": {
    "start": "node server.ts",
    "dev": "tsx watch server.ts",
    "build:client": "webpack --mode production",
    "watch:client": "webpack --mode development --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "canvas": "^3.2.0",
    "express": "^4.18.2",
    "fontkit": "^2.0.4",
    "onoff": "^6.0.3",
    "pi-spi": "^1.2.1",
    "spi-device": "^3.1.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "css-loader": "^7.1.2",
    "esbuild-loader": "^4.2.2",
    "html-webpack-plugin": "^5.6.3",
    "nodemon": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "style-loader": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1"
  },
  "keywords": [
    "node",
    "express",
    "epaper"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
